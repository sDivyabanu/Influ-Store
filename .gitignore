# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel
.env.local

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev media storage fallback (see src/lib/storage/local-storage.service.ts)
/public/uploads/

# local dev PRIVATE document storage fallback — never publicly served;
# see src/lib/storage/local-private-document-storage.service.ts
/private-uploads/
