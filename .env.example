
# --------------------------------------------------
# Database (PostgreSQL / Amazon RDS)
# --------------------------------------------------
# For local PostgreSQL or remote RDS instance:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/influstore?schema=public"

# --------------------------------------------------
# Authentication (JWT Sessions)
# --------------------------------------------------
# Secret key used for signing session tokens (generate with `openssl rand -base64 32`)
AUTH_SECRET="development-insecure-auth-secret-change-me-in-production-min-32-chars"

# --------------------------------------------------
# Application URL
# --------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------------
# AWS Configuration (Pending RDS / S3 Activation)
# --------------------------------------------------
# Leave these values blank until AWS services are active.
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""
